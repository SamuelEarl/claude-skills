{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "black": "#262B44",
    "blue": "#3183e0",
    "green": "#59C9A5",
    "dark_green": "#1d7056",
    "dark_gray": "#2f2f2f",
    "orange": "#F07623",
    "dark_orange": "#b85610",
    "purple": "#544983",
    "dark_red": "#b0164a",
    "sapling": "#a6d189",
    "white": "#E0DEF4",
    "yellow": "#F3AE35"
  },
  "accent_color": "32",
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "options": {
            "dir_length": 3,
            "folder_separator_icon": "\ue0bb",
            "style": "fish"
          },
          "template": "{{ if .Segments.Git.Dir }} \uf1d2 <i><b>{{ .Segments.Git.RepoName }}{{ if .Segments.Git.IsWorkTree }} \ue21c{{ end }}</b></i>{{ $rel :=  .Segments.Git.RelativeDir }}{{ if $rel }} \ueaf7 {{ .Format $rel }}{{ end }}{{ else }} \uea83 {{ path .Path .Location }}{{ end }} ",
          "foreground": "p:white",
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b0",
          "background": "p:dark_green",
          "type": "path",
          "style": "diamond"
        },
        {
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true
          },
          "template": " {{ if .UpstreamURL }}{{ url .UpstreamIcon .UpstreamURL }} {{ end }}{{ .HEAD }} {{ if .Working.Changed }}{{ nospace .Working.String }}{{ end }}{{ if .Staging.Changed }} \uf046 {{ .Staging.String }}{{ end }} ",
          "foreground": "p:black",
          "leading_diamond": "<transparent>\ue0b0</>",
          "trailing_diamond": "\ue0b4",
          "background": "p:green",
          "type": "git",
          "style": "diamond",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:black{{ end }}",
            "{{ if or (gt .Ahead 0) (gt .Behind 0) }}p:white{{ end }}"
          ],
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:yellow{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:red{{ end }}",
            "{{ if gt .Ahead 0 }}#49416D{{ end }}",
            "{{ if gt .Behind 0 }}#7A306C{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " \udb81\udea9 {{ .Model.DisplayName }} ",
          "foreground": "p:white",
          "background": "p:blue",
          "type": "claude",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " \uf2d0 Context Window: {{ .FormattedTokens | lower }} tokens (/clear at 120k)",
          "foreground": "p:white",
          "background": "p:blue",
          "type": "claude",
          "style": "diamond"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " \uf201 5H Usage: {{ .FiveHourUsage }}% | \uf253 Resets In: {{ secondsRound .FiveHourResetsIn.Seconds }} ",
          "foreground": "p:white",
          "background": "p:purple",
          "type": "claude",
          "style": "diamond"
        },
        {
          "leading_diamond": "\ue0b6",
          "trailing_diamond": "\ue0b4",
          "template": " \uf201 7D Usage: {{ .SevenDayUsage }}% | \uf253 Resets In: {{ secondsRound .SevenDayResetsIn.Seconds }} ",
          "foreground": "p:white",
          "background": "p:purple",
          "type": "claude",
          "style": "diamond"
        }
      ]
    }
  ],
  "version": 4
}
